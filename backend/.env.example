# Copy this file to ".env" and adjust the values.

# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./tradeflow.db
# PostgreSQL (uncomment and edit to use Postgres instead):
# DATABASE_URL=postgresql+psycopg2://tradeflow:tradeflow@localhost:5432/tradeflow

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
